# Kubernetes secrets and sensitive files
*.pem
*.crt
*.p12
*.pfx
private/

# Age encryption keys (keep .sops.yaml, ignore private keys)
secrets/keys/*.key
!secrets/.sops.yaml
!secrets/keys/README.md

# Unencrypted secrets files (only .enc versions should be committed)
*-secrets.yaml
!*-secrets.yaml.enc

# Environment and configuration files
.env
.env.local
.env.production
config.local.*
values-production.yaml

# Logs and temporary files
*.log
*.tmp
tmp/
logs/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Backup files
*.bak
*.backup
*.orig

# Local development overrides
docker-compose.override.yml
kustomization.local.yaml
values-local.yaml

# ArgoCD local state (if any)
.argocd/

# Helm charts dependencies
charts/*/charts/
*.tgz

# Local container images and build artifacts
*.tar
*.tar.gz
build/
dist/
node_modules/
__pycache__/
*.pyc
scenario-recorder/artifacts/

# Locally cloned django-app (if you clone it into this directory)
django-app/

.codex
